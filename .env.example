# ==============================================================================
# BOOKGRID (bookgrid.app) — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Company: GilByte Solutions
# Currencies Supported: USD ($) and EUR (€) ONLY via Paddle / Dodo -> Payoneer
# ⚠️ NEVER COMMIT REAL SECRETS TO GIT. COPY THIS FILE TO .env.local
# ==============================================================================

# 1. PUBLIC APPLICATION CONFIG
NEXT_PUBLIC_APP_NAME="BookGrid"
NEXT_PUBLIC_APP_URL="https://bookgrid.app"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# 2. SUPABASE (PUBLIC ANON & SERVER-ONLY SERVICE ROLE)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
# CRITICAL: Server-only key for verified webhooks. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"

# 3. GLOBAL BILLING — PADDLE / DODO PAYMENTS (PAYOUTS TO PAYONEER USD ACH / EUR SEPA)
NEXT_PUBLIC_PAYMENT_PROVIDER="paddle" # 'paddle' or 'dodo'
NEXT_PUBLIC_PADDLE_ENV="sandbox"      # 'sandbox' or 'production'
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_your_paddle_client_token"
NEXT_PUBLIC_PADDLE_PRICE_ID_USD="pri_usd_29_monthly"
NEXT_PUBLIC_PADDLE_PRICE_ID_EUR="pri_eur_25_monthly"

# CRITICAL: Server-only webhook signing secrets (HMAC-SHA256 verification)
PADDLE_API_KEY="pdl_sdbx_apikey_your_secret"
PADDLE_WEBHOOK_SECRET="pdl_ntfset_your_webhook_hmac_secret"
DODO_WEBHOOK_SECRET="whsec_your_dodo_webhook_hmac_secret"

# 4. AI SCHEDULE IMPORTER (SERVER-ONLY LLM API KEY)
AI_PROVIDER="gemini" # 'gemini' or 'openai'
GEMINI_API_KEY="your-server-only-gemini-api-key"
